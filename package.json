{
  "name": "wikiplane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "typecheck": "corepack pnpm -r typecheck",
    "test": "corepack pnpm -r build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "ci": "corepack pnpm run quality && corepack pnpm run test:node",
    "wikiplane": "tsx packages/cli/src/bin.ts",
    "mcp": "tsx packages/mcp/src/bin.ts",
    "policy:check": "node scripts/check-policy.mjs",
    "quality": "prettier --check . && eslint . --max-warnings=0 && node scripts/check-policy.mjs",
    "test:node": "corepack pnpm -r build && corepack pnpm -r typecheck && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
