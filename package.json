{
  "name": "wikiplane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r build && vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "ci": "pnpm format:check && pnpm lint && pnpm policy:check && pnpm build && pnpm typecheck && vitest run",
    "wikiplane": "tsx packages/cli/src/bin.ts",
    "mcp": "tsx packages/mcp/src/bin.ts",
    "policy:check": "node scripts/check-policy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
