#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$ROOT"

if [[ ! -d node_modules ]]; then
  echo "error: Node dependencies are not installed." >&2
  echo "hint: run scripts/bootstrap-node first." >&2
  exit 1
fi

# pnpm has no `ci` subcommand. Run the repository's `ci` package script.
# That script is the canonical deterministic Node validation entry point.
exec corepack pnpm run ci
