#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
VENV="${WIKIPLANE_VENV:-$ROOT/.venv}"

if [[ ! -x "$VENV/bin/python" ]]; then
  echo "error: Python test environment is not installed." >&2
  echo "hint: run scripts/bootstrap-python first." >&2
  exit 1
fi

cd "$ROOT"
exec "$VENV/bin/python" -m pytest -q \
  services/model-gateway/tests \
  services/markitdown/tests
